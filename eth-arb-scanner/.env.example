# Ethereum mainnet HTTPS RPC; must support eth_call state overrides.
RPC_HTTP_URL=https://eth-mainnet.g.alchemy.com/v2/REPLACE_ME
# Optional. Without it the scanner polls every 30 seconds.
RPC_WS_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
REPORT_TIME=21:00
REPORT_TIMEZONE=Europe/Berlin
# Start small. These are ETH/WETH amounts, NOT USD amounts.
TRADE_SIZES_ETH=0.005,0.02,0.1,0.5
MAX_POOLS=24
MIN_LIQUIDITY_USD=20000
MIN_VOLUME_24H_USD=500
MAX_SIMULATIONS_PER_BLOCK=4
MAX_RPC_CALLS_PER_DAY=15000
RPC_INTERVAL_MS=180
POLL_INTERVAL_MS=30000
MIN_NET_PROFIT_ETH=0.0005
MIN_SPREAD_BPS=20
GAS_MARGIN_BPS=2500
PRIORITY_FEE_GWEI=1
DATA_DIR=./data
